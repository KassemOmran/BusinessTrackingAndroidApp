<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/barcode"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Scan with -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Scan with"
            android:textStyle="bold"
            android:textSize="16sp"
            android:textColor="#009688"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Barcode scanner type"
            android:textSize="14sp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Camera (Mobile Vision)"
            android:textSize="12sp"
            android:textColor="#777777"
            android:layout_marginBottom="16dp"/>

        <!-- Batch mode scan -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Batch mode scan"
            android:textStyle="bold"
            android:textSize="16sp"
            android:textColor="#009688"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="After each scan"
            android:textSize="14sp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Autoincrement quantity by 1 (+1)"
            android:textSize="12sp"
            android:textColor="#777777"
            android:layout_marginBottom="16dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Scan delay (seconds)"
            android:textSize="14sp"/>
        <SeekBar
            android:id="@+id/seekScanDelay"
            android:layout_width="match_parent"
            android:layout_height="34dp"
            android:max="100"
            android:progress="0" />

        <!-- When barcode is found -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="When a barcode is found..."
            android:textStyle="bold"
            android:textSize="16sp"
            android:textColor="#009688"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="8dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Beep"
                android:textSize="14sp"/>

            <Switch
                android:id="@+id/switchBeep"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Vibrate"
                android:textSize="14sp"/>

            <Switch
                android:id="@+id/switchvibrate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"/>
        </LinearLayout>

        <!-- General settings -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="General settings"
            android:textStyle="bold"
            android:textSize="16sp"
            android:textColor="#009688"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Use front light"
            android:textSize="14sp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Off"
            android:textSize="12sp"
            android:textColor="#777777"
            android:layout_marginBottom="16dp"/>

        <!-- Camera -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Camera"
            android:textStyle="bold"
            android:textSize="16sp"
            android:textColor="#009688"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Barcode viewfinder width"
            android:textSize="14sp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Relative to the camera view width, ranges from 50% to 95%"
            android:textSize="12sp"
            android:textColor="#777777"/>

        <SeekBar
            android:id="@+id/seekScan"
            android:layout_width="match_parent"
            android:layout_height="34dp"
            android:max="100"
            android:progress="0" />


    </LinearLayout>
</ScrollView>
