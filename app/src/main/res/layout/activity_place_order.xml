<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <!-- 1️⃣ Title -->
    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Place Order"
        android:textSize="22sp"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>

    <!-- 2️⃣ Order Type -->
    <RadioGroup
        android:id="@+id/orderTypeGroup"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintTop_toBottomOf="@id/tvTitle"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="16dp">

        <RadioButton
            android:id="@+id/rbOutgoing"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Outgoing"/>

        <RadioButton
            android:id="@+id/rbIncoming"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Incoming"/>
    </RadioGroup>

    <!-- 3️⃣ Inventory List -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/placeOrderRV"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/orderTypeGroup"
        app:layout_constraintBottom_toTopOf="@id/placeOrderBtn"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- 4️⃣ Place Order Button -->
    <Button
        android:id="@+id/placeOrderBtn"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Place Order"
        android:layout_marginTop="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>
