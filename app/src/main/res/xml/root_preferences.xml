<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <!-- Main navigation preferences -->
    <Preference
        android:key="general"
        android:title="General" />

    <Preference
        android:key="barcode"
        android:title="Barcode" />

    <Preference
        android:key="mycompany"
        android:title="My Company" />

    <Preference
        android:key="prices"
        android:title="Prices" />

    <!-- Messages category -->
    <PreferenceCategory
        app:title="@string/messages_header">

        <EditTextPreference
            app:key="signature"
            app:title="@string/signature_title"
            app:useSimpleSummaryProvider="true" />

        <ListPreference
            app:key="reply"
            app:title="@string/reply_title"
            app:defaultValue="reply"
            app:entries="@array/reply_entries"
            app:entryValues="@array/reply_values"
            app:useSimpleSummaryProvider="true" />
    </PreferenceCategory>

    <!-- Sync category -->
    <PreferenceCategory
        app:title="@string/sync_header">

        <SwitchPreferenceCompat
            app:key="sync"
            app:title="@string/sync_title" />

        <SwitchPreferenceCompat
            app:key="attachment"
            app:dependency="sync"
            app:title="@string/attachment_title"
            app:summaryOn="@string/attachment_summary_on"
            app:summaryOff="@string/attachment_summary_off" />
    </PreferenceCategory>

    <PreferenceCategory
        android:title="Notifications">

        <!-- Low stock threshold -->
        <EditTextPreference
            android:key="low_stock_threshold"
            android:title="Low stock alert"
            android:summary="Notify when item quantity is low"
            android:dialogTitle="Low stock threshold"
            android:defaultValue="5"
            android:inputType="number" />

        <!-- Expiry warning -->
        <EditTextPreference
            android:key="expiry_warning_days"
            android:title="Expiry alert"
            android:summary="Notify before product expires"
            android:dialogTitle="Expiry warning days"
            android:defaultValue="7"
            android:inputType="number" />

    </PreferenceCategory>

</PreferenceScreen>